# Tatum (required): https://dashboard.tatum.io → API keys (mainnet)
TATUM_API_KEY=
TATUM_DAILY_CREDIT_CAP=60000

# Walrus Memory on Mainnet (required): https://memory.walrus.xyz → create an agent
MEMWAL_ACCOUNT_ID=
MEMWAL_PRIVATE_KEY=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Database: local SQLite file by default; libsql://… plus a token for Turso in production
DATABASE_URL=file:./data/credence.db
DATABASE_AUTH_TOKEN=

# Sui receipts (optional, later): generated by scripts/sui-keygen.ts
SUI_RECEIPTS_PRIVATE_KEY=
SUI_RECEIPTS_PACKAGE_ID=

# Sportsbook odds (optional): https://the-odds-api.com
ODDS_API_KEY=

# Protects /api/cron/tick; any long random string
CRON_SECRET=
# Enables the Amnesia demo button on /brain
AMNESIA_ENABLED=false
